# Aikyra environment variables (template)
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to Git.

# --- Database ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/aikyra

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Deployment (Railway backend / Vercel frontend) ---
# Frontend origin to allow for CORS. In production set this to the deployed
# Vercel URL (e.g. https://<project>.vercel.app). Localhost dev origins are
# always allowed on top of this.
# FRONTEND_URL=https://<project>.vercel.app

# --- JWT Authentication (Phase 4C) ---
# REQUIRED before deploying to Railway. Generate a strong random secret, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If this is missing in a deployed (Railway) environment, startup fails clearly
# instead of falling back to the development secret.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# --- Demo (hackathon) ---
# Set to true to enable the demo-only funding contribution endpoint:
# POST /api/projects/{project_id}/funding/contributions/demo
# Absent or anything other than "true" makes the endpoint return 404.
# DEMO_MODE=true

# --- AI (for later phases) ---
OLLAMA_BASE_URL=http://localhost:11434
